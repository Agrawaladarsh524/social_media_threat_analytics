# Copy to .env and set real values. Never commit .env.

# false in production
DEBUG=true

# Browser origins allowed to call the API. Ignored when DEBUG=true (all origins allowed).
# The Streamlit frontend calls the API server-side, so it is unaffected by this.
CORS_ALLOWED_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# Database: omit for SQLite (backend/osint.db). Example for Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/osint_guard
# Tables are created automatically on startup.

# Apify (live OSINT collection). Leave empty to skip actor runs.
APIFY_API_TOKEN=
# APIFY_ACTOR_TWITTER=dy7gIgPRMhrOrfW0f

# OpenAI (AI insights). Required for /api/insights/ and /api/upload-bulk/.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_REQUEST_TIMEOUT=30      # seconds per OpenAI request
# AI_CACHE_TTL_HOURS=24          # hours before a cached AI bundle is re-generated
